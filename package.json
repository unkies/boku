{
  "name": "@unkies/boku",
  "version": "2026.10.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "homepage": "https://github.com/unkies/boku",
  "repository": "github:unkies/boku",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "rm -rf dist && bun build --target=bun --format=esm --sourcemap --outdir=dist src/index.ts && chmod +x dist/index.js",
    "check": "bun check --project tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "bun test --timeout 600000 --parallel=8",
    "test:coverage": "bun test --timeout 600000 --parallel=8 --coverage --coverage-reporter=lcov",
    "smoke": "bun scripts/smoke.ts",
    "ci": "bun run format:check && bun run lint && bun run check && bun run test:coverage && bun run build && bun run smoke",
    "cli": "bun src/index.ts",
    "compile": "rm -rf pkg && bun build --compile src/index.ts --outfile pkg/bk",
    "dev:install": "bun scripts/devinstall.ts install",
    "dev:uninstall": "bun scripts/devinstall.ts uninstall",
    "compile:all": "bun scripts/compile_all.ts",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "chalk": "6.0.1",
    "fast-json-stable-hash": "1.0.3",
    "fs-extra": "11.4.1",
    "prompts": "2.4.2",
    "strip-ansi": "7.2.0",
    "yargs": "18.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/fs-extra": "11.0.4",
    "@types/prompts": "2.4.9",
    "@types/yargs": "17.0.35",
    "bun-types": "1.4.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
