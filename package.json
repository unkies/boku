{
  "private": true,
  "name": "charcoal",
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "bun run --cwd apps/cli build",
    "check": "bun run --cwd apps/cli check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "bun run --cwd apps/cli test",
    "test:coverage": "bun run --cwd apps/cli test:coverage",
    "smoke": "bun run --cwd apps/cli smoke",
    "ci": "bun run format:check && bun run lint && bun run check && bun run test:coverage && bun run build && bun run smoke",
    "cli": "bun run --cwd apps/cli cli"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "bun-types": "1.4.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
