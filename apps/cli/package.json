{
  "name": "@unkies/charcoal",
  "version": "0.2.4",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "homepage": "https://github.com/unkies/charcoal",
  "repository": "github:unkies/charcoal",
  "dependencies": {
    "@unkies/gti-cli-shared-types": "workspace:*",
    "chalk": "6.0.1",
    "fast-json-stable-hash": "1.0.3",
    "fs-extra": "11.4.1",
    "prompts": "2.4.2",
    "strip-ansi": "7.2.0",
    "yargs": "18.2.0",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun check --project tsconfig.json",
    "lint": "eslint .",
    "build": "rm -rf dist && bun build --target=bun --format=esm --sourcemap --outdir=dist src/index.ts && chmod +x dist/index.js",
    "cli": "bun src/index.ts",
    "test": "bun test --timeout 600000 --parallel=8",
    "test:coverage": "bun test --timeout 600000 --parallel=8 --coverage --coverage-reporter=lcov",
    "smoke": "bun scripts/smoke.ts",
    "compile": "rm -rf pkg && bun build --compile src/index.ts --outfile pkg/gt",
    "compile:all": "bun scripts/compile_all.ts",
    "prepack": "bun run build"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "graphite": "dist/index.js",
    "gt": "dist/index.js"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/prompts": "2.4.9",
    "@types/yargs": "17.0.35"
  }
}
